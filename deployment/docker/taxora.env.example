# Taxora docker-compose environment — copy to taxora.env and fill in values
# (DATABASE__HOST/PORT are set directly in docker-compose.yml — no need to set them here)

DATABASE__USER=taxora
DATABASE__PASSWORD=change-me
DATABASE__DATABASE=taxora

TEMPORAL_ADDRESS=temporal-ssh.florence.place:7233
TEMPORAL_TASK_QUEUE=taxora-task-queue

GBIF_BASE_URL=https://api.gbif.org/v1
