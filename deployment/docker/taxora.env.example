# Compose-ready Taxora config — copy to ../../.dev.env (gitignored) and set the password.
# Hostnames are compose service names, not localhost.

HOST=0.0.0.0
PORT=8000

TEMPORAL_ADDRESS=temporal:7233
TEMPORAL_TASK_QUEUE=taxora-task-queue

# Synthetic GBIF served by the mock-gbif service
GBIF_BASE_URL=http://mock-gbif:9000/v1

DATABASE__HOST=db
DATABASE__PORT=5432
DATABASE__USER=taxora
DATABASE__PASSWORD=change-me
DATABASE__DATABASE=taxora_dev

SESSION_SECRET=change-me-in-production
