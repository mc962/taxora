# Taxora environment — copy to /etc/taxora.env and fill in values

HOST=0.0.0.0
PORT=8000

TEMPORAL_ADDRESS=temporal-ssh.florence.place:7233
TEMPORAL_TASK_QUEUE=taxora-task-queue

GBIF_BASE_URL=https://api.gbif.org/v1

# Point at a Postgres instance you manage yourself (no bundled DB with this deployment path)
DATABASE__HOST=localhost
DATABASE__PORT=5432
DATABASE__USER=taxora
DATABASE__PASSWORD=
DATABASE__DATABASE=taxora
