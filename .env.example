# Taxora environment — copy to .env and fill in values

# Server
HOST=0.0.0.0
PORT=8000

# Temporal
TEMPORAL_ADDRESS=temporal-internal.florence.place:7233
TEMPORAL_TASK_QUEUE=taxora-task-queue

# GBIF
GBIF_BASE_URL=https://api.gbif.org/v1

# Database (Postgres)
